APP_NAME=AgriSphere
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# SQLite works out of the box for local dev (php artisan migrate --seed).
# For production, switch to mysql/pgsql and fill in the DB_* variables below.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=agrisphere
# DB_USERNAME=
# DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Comma-separated list of frontend origins allowed to authenticate via Sanctum.
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# Comma-separated list of exact frontend origins allowed to call this API
# (e.g. https://agrisphere.vercel.app). Do not leave this as '*' once real
# users are involved.
CORS_ALLOWED_ORIGINS=*

# Google Gemini API key (https://aistudio.google.com/apikey) used by the
# Plant Doctor AI diagnosis feature and to phrase Smart Alerts messages.
# Leave empty to disable Plant Doctor; Smart Alerts still works without it,
# falling back to plain template messages instead of AI-phrased ones.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
